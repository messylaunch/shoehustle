// Well Kept data model.
//
// Postgres, because the app is deployed to Vercel and a serverless host has
// no disk to keep a SQLite file on — it would be wiped on every deploy.
//
// Status-style columns are plain strings rather than Postgres enums, backed
// by the constant lists in src/lib/constants.ts: adding a new status is then
// a code change, not a migration. Money is always integer cents.
//
// DATABASE_URL is the pooled connection (what the app uses). DIRECT_URL is
// the unpooled one, used only for migrations — connection poolers refuse the
// statements migrations need to run.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SELLER") // ADMIN | SELLER
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Storefront identity
  handle String? @unique
  bio    String?

  // Stripe Connect. stripeReady flips true once onboarding completes.
  stripeAccountId String?
  stripeReady     Boolean @default(false)

  // Pricing defaults, all in cents. Used by the buy calculator.
  targetProfitCents Int @default(3000)
  shipOutCents      Int @default(1200)
  cleanCostCents    Int @default(800)
  restoreCostCents  Int @default(1800)

  // What the buyer pays for shipping, and what the platform takes from this
  // seller's sales, in basis points (1100 = 11%).
  buyerShippingCents Int @default(1200)
  platformFeeBps     Int @default(0)

  // Affiliate side. A reseller shares /r/<handle>; sales through that link
  // pay them commissionBps of the margin (list price minus cost), and they
  // can also buy any pair at its reseller price and sell it themselves.
  isReseller    Boolean @default(false)
  commissionBps Int     @default(3000)

  // Network side. A HOLDER physically keeps stock in their city and runs the
  // pickup meets; a SELLER finds buyers and holds nothing. Both are paid out
  // of the margin, never out of the seller's pocket.
  isHolder  Boolean @default(false)
  city      String?
  // Their share of the margin, in basis points, when they play that part on
  // a sale. Someone can be both, in which case they earn both.
  holderBps Int     @default(1500)

  heldItems       InventoryItem[]  @relation("ItemHolder")
  pickupLocations PickupLocation[]
  soldOrders      Order[]          @relation("OrderSoldBy")

  sessions       Session[]
  channels       Channel[]
  items          InventoryItem[]
  orders         Order[]
  referredOrders Order[]         @relation("OrderReseller")
  invitesCreated Invite[]        @relation("InviteCreator")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String
  name        String
  role        String    @default("SELLER")
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
}

// A selling channel and what it costs you. Whatnot, eBay and cash in hand are
// three different numbers, and max buy price depends on which one you'd use.
model Channel {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  feeBps        Int
  fixedFeeCents Int     @default(0)
  isDefault     Boolean @default(false)
  sortOrder     Int     @default(0)

  @@index([userId])
}

// A model/colorway in the catalog. One Shoe, many physical pairs.
model Shoe {
  id          String   @id @default(cuid())
  brand       String
  model       String
  colorway    String?
  styleCode   String?  @unique
  nickname    String?
  retailCents Int?
  imageUrl    String?
  createdAt   DateTime @default(now())

  items InventoryItem[]
  comps Comp[]

  @@index([brand, model])
}

// A physical pair you own.
model InventoryItem {
  id       String @id @default(cuid())
  shoeId   String
  shoe     Shoe   @relation(fields: [shoeId], references: [id])
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  size     String
  sizeType String @default("M") // M | W | GS | PS | TD
  grade    String // DS | VNDS | G9 | G8 | G7 | G6
  status   String @default("SOURCING")

  costCents    Int       @default(0)
  acquiredFrom String?
  acquiredAt   DateTime?

  // Asking price, plus what the calculator estimated in each lane.
  listPriceCents   Int?
  estAsIsCents     Int?
  estCleanCents    Int?
  estRestoredCents Int?

  // What a reseller in the network pays for this pair. The gap between this
  // and listPriceCents is their margin if they sell it themselves.
  resellerPriceCents Int?

  // What the pair goes for new, shown to buyers so they can see the deal.
  marketNewCents Int?

  // Honesty about what's wrong with it. Comma-separated flaw codes from
  // src/lib/constants.ts, plus anything that needs saying in words.
  flaws     String?
  flawNotes String?

  // The grade card. This is what separates your Reverse Panda from someone
  // else's identical Reverse Panda: not the photos, the numbers.
  // Overall is 1-10; the parts are 1-5.
  ratingOverall Int?
  ratingUpper   Int?
  ratingMidsole Int?
  ratingOutsole Int?
  ratingInsole  Int?
  ratingSmell   Int?

  // Which holder physically has this pair right now. Null means it's with
  // the owner. Customers never see this.
  holderId String?
  holder   User?   @relation("ItemHolder", fields: [holderId], references: [id])

  // When it went live, so stock that isn't moving can be surfaced to the
  // network instead of sitting in one person's closet.
  listedAt DateTime?

  restorationEta   DateTime?
  restorationNotes String?
  // What was actually done to it — becomes the "how it was treated" list
  // on the public page.
  treatments String?

  notes     String?
  soldAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  photos   ItemPhoto[]
  comps    Comp[]
  orders   Order[]
  auctions Auction[]

  @@index([sellerId, status])
  @@index([status, size])
}

model ItemPhoto {
  id     String        @id @default(cuid())
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url    String
  sort   Int           @default(0)

  @@index([itemId])
}

// A comparable sale. Entered by hand from a StockX/eBay/GOAT lookup, so it
// carries the URL it came from and whether it was a real sale or just an ask.
model Comp {
  id         String         @id @default(cuid())
  shoeId     String?
  shoe       Shoe?          @relation(fields: [shoeId], references: [id], onDelete: Cascade)
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  source     String // STOCKX | EBAY | GOAT | GOOGLE | OTHER
  kind       String // SOLD | ASK
  priceCents Int
  size       String?
  grade      String?
  url        String?
  note       String?
  capturedAt DateTime       @default(now())

  @@index([shoeId])
  @@index([itemId])
}

model Order {
  id       String        @id @default(cuid())
  ref      String        @unique
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id])
  sellerId String
  seller   User          @relation(fields: [sellerId], references: [id])

  buyerEmail  String
  buyerName   String
  shipLine1   String?
  shipLine2   String?
  shipCity    String?
  shipState   String?
  shipPostal  String?
  shipCountry String?

  subtotalCents    Int
  shippingCents    Int
  taxCents         Int @default(0)
  totalCents       Int
  platformFeeCents Int @default(0)

  // Set when the buyer arrived through a reseller's link. resellerCutCents
  // is what that reseller earned on the sale.
  resellerId       String?
  reseller         User?   @relation("OrderReseller", fields: [resellerId], references: [id])
  resellerCutCents Int     @default(0)

  // Who actually closed it, when a person in the network made the sale
  // rather than the shop doing it on its own.
  soldById       String?
  soldBy         User?   @relation("OrderSoldBy", fields: [soldById], references: [id])
  sellerCutCents Int     @default(0)
  holderCutCents Int     @default(0)

  // How it gets to the buyer. Pickup is the default because it's worth about
  // double a shipped sale.
  fulfillment      String          @default("SHIPPING") // PICKUP | DELIVERY | SHIPPING
  pickupLocationId String?
  pickupLocation   PickupLocation? @relation(fields: [pickupLocationId], references: [id])
  pickupAt         DateTime?
  handedOverAt     DateTime?

  status                String  @default("PENDING") // PENDING | PAID | SHIPPED | CANCELLED | REFUNDED
  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  trackingCarrier String?
  trackingNumber  String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  shippedAt DateTime?

  @@index([sellerId, status])
}

// Someone whose size wasn't in stock. This list is the whole point of the
// storefront - it's the audience no platform can throttle.
//
// One row per size per person, so a parent can watch their own size and each
// of their kids' sizes separately.
model SizeAlert {
  id         String    @id @default(cuid())
  email      String
  size       String
  sizeType   String    @default("M")
  // Who they're watching this size for: "me", "my son", "my daughter"...
  forWho     String?
  note       String?
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@index([size])
}

// The weekly drop. One hot pair, a countdown, and public bidding. It exists
// to give people a reason to come back on a schedule.
model Auction {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title      String?
  startCents Int
  // Below this, you don't have to sell. Hidden from bidders.
  reserveCents Int?
  // Smallest allowed raise over the current high bid.
  incrementCents Int      @default(500)
  startsAt       DateTime @default(now())
  endsAt         DateTime
  status         String   @default("LIVE") // LIVE | CLOSED | CANCELLED
  createdAt      DateTime @default(now())

  bids Bid[]

  @@index([status, endsAt])
}

model Bid {
  id          String   @id @default(cuid())
  auctionId   String
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderEmail String
  bidderName  String
  amountCents Int
  createdAt   DateTime @default(now())

  @@index([auctionId, amountCents])
}

// A browser that asked for push notifications. Endpoint is unique per
// device per site; keys are what the push service needs to encrypt to it.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Optional link back to a shopper, so we can target their sizes.
  email     String?
  createdAt DateTime @default(now())
  failedAt  DateTime?

  @@index([email])
}

model RestorationRequest {
  id              String    @id @default(cuid())
  name            String
  email           String
  phone           String?
  shoeDescription String
  condition       String?
  photoUrl        String?
  status          String    @default("NEW") // NEW | QUOTED | ACCEPTED | IN_PROGRESS | DONE | DECLINED
  quoteCents      Int?
  etaDate         DateTime?
  internalNotes   String?
  createdAt       DateTime  @default(now())
}

// Global site config: shop name, tagline, contact line.
model Setting {
  key   String @id
  value String
}

// Where and when you hand shoes over. The whole "shoe guy" model runs on
// this being the same place at the same time every week, so people can plan
// around it. Everything is paid for before the meet - nobody is standing in
// a parking lot counting cash.
model PickupLocation {
  id       String  @id @default(cuid())
  name     String
  address  String
  city     String
  notes    String?
  // 0 = Sunday. Kept as a weekly slot rather than individual dates because
  // predictability is the point.
  dayOfWeek Int
  startTime String // "18:00"
  endTime   String // "19:30"
  active    Boolean @default(true)

  // Whoever runs this meet and holds the stock for it.
  holderId String?
  holder   User?   @relation(fields: [holderId], references: [id])

  orders Order[]

  @@index([active, dayOfWeek])
}

// Somebody offering you their old pairs, for cash or credit. The car-lot
// trade-in, which is also your cheapest source of inventory.
model TradeIn {
  id     String  @id @default(cuid())
  name   String
  email  String
  phone  String?
  city   String?

  description String
  brand       String?
  size        String?
  condition   String?
  photoUrl    String?

  // NEW -> OFFERED -> ACCEPTED -> RECEIVED -> DECLINED
  status      String @default("NEW")
  // What you'll pay in cash, and what you'd give as shop credit instead.
  offerCents  Int?
  creditCents Int?
  notes       String?

  createdAt DateTime @default(now())

  @@index([status])
}
