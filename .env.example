# Copy this file to .env. Only DATABASE_URL is required — the app runs
# without any of the others, it just turns off the features that need them.

# ---------------------------------------------------------------------------
# Required — the database
# ---------------------------------------------------------------------------
#
# Postgres. On Vercel, add the Neon integration from the Storage tab and it
# sets these for you; check the names match the two below and rename if not.
#
# DATABASE_URL is the POOLED connection — what the running app uses.
# DIRECT_URL is the UNPOOLED one — used only when migrations run at build
# time, because connection poolers reject the statements migrations need.
#
# Both are required. If you only have one connection string, put it in both.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Optional — photo shoe ID
# ---------------------------------------------------------------------------
# Without this, the calculator still works; you just type the shoe in by hand
# instead of photographing it. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."

# ---------------------------------------------------------------------------
# Optional — taking payments
# ---------------------------------------------------------------------------
# Without these, the storefront shows a "Message to buy" button instead of a
# checkout. Keys are at https://dashboard.stripe.com/apikeys — start with the
# test keys (sk_test_/pk_test_) until you've placed a fake order end to end.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, or
# from the webhook you create in the Stripe dashboard. Without it, orders stay
# stuck at "awaiting payment" because nothing tells the app the card cleared.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Optional — push notifications
# ---------------------------------------------------------------------------
# Lets shoppers install the shop to their home screen AND get pinged when
# their size lands. Without these they can still install it, they just never
# hear from you — which is most of the reason they installed it.
#
# Run `npm run push:keys` once and paste both values here. Changing them later
# forces every shopper to opt in again, so generate once and leave them alone.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
# VAPID_PRIVATE_KEY="..."

# ---------------------------------------------------------------------------
# Required in production — photo storage
# ---------------------------------------------------------------------------
# Vercel has no disk that survives a deploy, so shoe photos go to Blob
# storage. In the Vercel dashboard: Storage > Create > Blob, connect it to
# the project, and this gets set automatically.
#
# Leave it unset locally and photos are written to public/uploads instead.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---------------------------------------------------------------------------
# Optional — deployment
# ---------------------------------------------------------------------------
# The public address of your site. Used for share links, Stripe redirects and
# seller onboarding returns. Set this to your real domain before you go live —
# share links and Stripe returns will point at localhost until you do.
APP_URL="http://localhost:3000"
