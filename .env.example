# Copy this file to .env. Only DATABASE_URL is required — the app runs
# without any of the others, it just turns off the features that need them.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Where the SQLite file lives. Nothing to install; the file is created for you.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Optional — photo shoe ID
# ---------------------------------------------------------------------------
# Without this, the calculator still works; you just type the shoe in by hand
# instead of photographing it. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."

# ---------------------------------------------------------------------------
# Optional — taking payments
# ---------------------------------------------------------------------------
# Without these, the storefront shows a "Message to buy" button instead of a
# checkout. Keys are at https://dashboard.stripe.com/apikeys — start with the
# test keys (sk_test_/pk_test_) until you've placed a fake order end to end.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, or
# from the webhook you create in the Stripe dashboard. Without it, orders stay
# stuck at "awaiting payment" because nothing tells the app the card cleared.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Optional — deployment
# ---------------------------------------------------------------------------
# The public address of your site. Used for share links, Stripe redirects and
# seller onboarding returns. Set this before you go live.
APP_URL="http://localhost:3000"
